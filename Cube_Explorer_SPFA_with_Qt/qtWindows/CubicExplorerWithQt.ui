     <widget class="QWidget" name="tab_Interaction">
      <attribute name="title">
       <string>交互2-控制</string>
      </attribute>
      <layout class="QHBoxLayout" name="horizontalLayout_15">
       <property name="spacing">
        <number>3</number>
       </property>
       <property name="leftMargin">
        <number>0</number>
       </property>
       <property name="topMargin">
        <number>0</number>
       </property>
       <property name="rightMargin">
        <number>0</number>
       </property>
       <property name="bottomMargin">
        <number>0</number>
       </property>
       <item>
        <widget class="QTextBrowser" name="textBrowser">
         <property name="sizePolicy">
          <sizepolicy hsizetype="Minimum" vsizetype="Expanding">
           <horstretch>0</horstretch>
           <verstretch>0</verstretch>
          </sizepolicy>
         </property>
         <property name="minimumSize">
          <size>
           <width>330</width>
           <height>0</height>
          </size>
         </property>
         <property name="font">
          <font>
           <pointsize>10</pointsize>
          </font>
         </property>
         <property name="html">
          <string>&lt;!DOCTYPE HTML PUBLIC &quot;-//W3C//DTD HTML 4.0//EN&quot; &quot;http://www.w3.org/TR/REC-html40/strict.dtd&quot;&gt;
&lt;html&gt;&lt;head&gt;&lt;meta name=&quot;qrichtext&quot; content=&quot;1&quot; /&gt;&lt;style type=&quot;text/css&quot;&gt;
p, li { white-space: pre-wrap; }
&lt;/style&gt;&lt;/head&gt;&lt;body style=&quot; font-family:'Consolas'; font-size:10pt; font-weight:400; font-style:normal;&quot;&gt;
&lt;p style=&quot; margin-top:0px; margin-bottom:0px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px;&quot;&gt;&lt;span style=&quot; font-weight:600;&quot;&gt;【提示】&lt;/span&gt;&lt;/p&gt;
&lt;p style=&quot; margin-top:0px; margin-bottom:0px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px;&quot;&gt;交互-控制模式允许用户控制双臂二指解魔方机器人进行魔方还原，感受机器人还原魔方与人手还原魔方的不同之处。&lt;/p&gt;
&lt;p style=&quot;-qt-paragraph-type:empty; margin-top:0px; margin-bottom:0px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px;&quot;&gt;&lt;br /&gt;&lt;/p&gt;
&lt;p style=&quot; margin-top:0px; margin-bottom:0px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px;&quot;&gt;&lt;span style=&quot; font-weight:600;&quot;&gt;【操作方法】&lt;/span&gt;&lt;/p&gt;
&lt;p style=&quot; margin-top:0px; margin-bottom:0px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px;&quot;&gt;&lt;span style=&quot; font-weight:600;&quot;&gt;1. &lt;/span&gt;将魔方放置于机械爪间后 按下操作盒上的 &lt;span style=&quot; font-weight:600;&quot;&gt;“闭合”&lt;/span&gt; 按钮 或 点击UI界面的 &lt;span style=&quot; font-weight:600;&quot;&gt;“闭合” &lt;/span&gt;按钮，闭合双臂夹爪；&lt;/p&gt;
&lt;p style=&quot; margin-top:0px; margin-bottom:0px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px;&quot;&gt;&lt;span style=&quot; font-weight:600;&quot;&gt;2. &lt;/span&gt;点击 UI界面的&lt;span style=&quot; font-weight:600;&quot;&gt; “打乱” &lt;/span&gt;按钮，系统会随机对魔方进行打乱；&lt;/p&gt;
&lt;p style=&quot; margin-top:0px; margin-bottom:0px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px;&quot;&gt;&lt;span style=&quot; font-weight:600;&quot;&gt;3. &lt;/span&gt;点击 UI界面的 &lt;span style=&quot; font-weight:600;&quot;&gt;“建模”&lt;/span&gt; 按钮，系统会对魔方进行识别并建模；&lt;/p&gt;
&lt;p style=&quot; margin-top:0px; margin-bottom:0px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px;&quot;&gt;&lt;span style=&quot; font-weight:600;&quot;&gt;4. &lt;/span&gt;点击 UI界面的 &lt;span style=&quot; font-weight:600;&quot;&gt;“开始/结束”&lt;/span&gt; 按钮，用户可以使用 &lt;span style=&quot; font-weight:600;&quot;&gt;“WASD”&lt;/span&gt; 及 &lt;span style=&quot; font-weight:600;&quot;&gt;“↑←↓→”&lt;/span&gt; 键对机器人的左右臂进行控制，计时器开始计时。其中，&lt;span style=&quot; font-weight:600;&quot;&gt;“↑”&lt;/span&gt; 表示松开右臂夹爪，&lt;span style=&quot; font-weight:600;&quot;&gt;“↓”&lt;/span&gt; 表示闭合右臂夹爪，&lt;span style=&quot; font-weight:600;&quot;&gt;“←”&lt;/span&gt; 表示右臂夹爪逆时针旋转90°，&lt;span style=&quot; font-weight:600;&quot;&gt;“→”&lt;/span&gt; 表示右臂夹爪顺时针旋转90°，同理可得 “WASD” 的用法。&lt;/p&gt;
&lt;p style=&quot; margin-top:0px; margin-bottom:0px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px;&quot;&gt;&lt;span style=&quot; font-weight:600;&quot;&gt;5. &lt;/span&gt;再次点击 UI界面的 &lt;span style=&quot; font-weight:600;&quot;&gt;“开始/结束” &lt;/span&gt;按钮，交互结束，计时器暂停。&lt;/p&gt;&lt;/body&gt;&lt;/html&gt;</string>
         </property>
        </widget>
       </item>
