#comp_btn_user_timerReset {
    background-color: #FFFFFF;
    border: 1px solid #e0e0e0; /* 修正 border 属性，指定宽度、样式和颜色 */
    border-radius: 20px; /* 圆角边框 */
    height: 40px;
    width: 39px;
    padding-left: 1px; /* 设置左内边距为 2.5px */
}

#comp_btn_user_timerReset:hover {
    background-color: hsl(212, 5%, 95%);
}
</string>
