                  <string notr="true">/* 为名为 btn_timerReset 的按钮设置样式 */
#btn_timerReset {
    background-color: #FFFFFF;
    border: 1px solid #e0e0e0; /* 修正 border 属性，指定宽度、样式和颜色 */
    border-radius: 14px; /* 圆角边框 */
    height: 28px;
    width: 27px;
    padding-left: 1px; /* 设置左内边距为 2.5px */
}

#btn_timerReset:hover {
    background-color: hsl(212, 5%, 95%);
}
</string>
                 </property>
