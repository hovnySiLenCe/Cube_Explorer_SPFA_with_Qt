                       <item>
                        <widget class="QPushButton" name="comp_btn_cp_timerStop">
                         <property name="styleSheet">
                          <string notr="true">/* 为名为 btn_timerStop 的按钮设置样式 */
#comp_btn_cp_timerStop {
    background-color: rgb(255, 149, 19); /* 背景颜色为橙色 */
    color: white; /* 文本颜色为白色 */
    border-radius: 20px; /* 圆角边框 */
    height: 40px;
    width: 39px;
    padding-left: 2px; /* 设置左内边距为 2px */
}

#comp_btn_cp_timerStop:hover {
    background-color: rgb(255, 112, 16); /* 鼠标悬停时背景颜色变为深橙色 */
}
</string>
                         </property>
                         <property name="text">
                          <string/>
                         </property>
                         <property name="icon">
                          <iconset>
                           <normaloff>source/start.png</normaloff>
                           <normalon>source/stop.png</normalon>source/start.png</iconset>
                         </property>
                        </widget>
