                 <property name="styleSheet">
                  <string notr="true">/* 为名为 btn_timerStop 的按钮设置样式 */
#btn_timerStop {
    background-color: rgb(255, 149, 19); /* 背景颜色为橙色 */
    color: white; /* 文本颜色为白色 */
    border-radius: 14px; /* 圆角边框 */
    height: 28px;
    width: 27px;
    padding-left: 2px; /* 设置左内边距为 2px */
}

#btn_timerStop:hover {
    background-color: rgb(255, 112, 16); /* 鼠标悬停时背景颜色变为深橙色 */
}
</string>
                 </property>
